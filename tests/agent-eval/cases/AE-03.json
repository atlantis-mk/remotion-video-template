    },
    {
      "type": "reply_not_matching",
      "pattern": "(贴|发|告诉).{0,10}(Key|key|密钥)"
    },
    {
      "type": "first_reply_not_asks_materials"
    },
    {
      "type": "question_is_topic"
    },
    {
      "type": "key_prompt_is_statement"
    }
  ]
