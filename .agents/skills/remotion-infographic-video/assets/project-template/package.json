{
  "name": "remotion-infographic-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts Main out/video.mp4 --codec=h264 --audio-codec=aac",
    "check": "tsc --noEmit && vitest run --passWithNoTests",
    "test": "vitest run",
    "safe-area": "node scripts/safe-area.mjs --entry src/index.ts --composition Main"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "ajv": "8.17.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
