{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subtitles.schema.json",
  "type": "object",
  "required": [
    "engine",
    "speaker",
    "cues"
  ],
  "properties": {
    "engine": {
      "type": "string"
    },
    "speaker": {
      "type": "string"
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "line_id",
          "text",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "line_id": {
            "type": "string",
            "pattern": "^[0-9]{2,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "start",
                "end"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
