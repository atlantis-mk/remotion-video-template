{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "licenses.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "allowed",
    "no_attribution",
    "denied"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^A-Z]+$"
      }
    },
    "no_attribution": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^A-Z]+$"
      }
    },
    "denied": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^A-Z]+$"
      }
    }
  }
}