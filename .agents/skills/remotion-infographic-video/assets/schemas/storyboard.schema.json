{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "type": "object",
  "required": [
    "version",
    "aspect",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "aspect": {
      "enum": [
        "landscape",
        "portrait"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "palette",
          "transition",
          "shots"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "palette": {
            "type": "object",
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "enum": [
                  "gold",
                  "green",
                  "red",
                  "blue",
                  "purple"
                ]
              },
              "b": {
                "enum": [
                  "gold",
                  "green",
                  "red",
                  "blue",
                  "purple"
                ]
              }
            }
          },
          "transition": {
            "enum": [
              "wipe",
              "zoom",
              "blur",
              "slide",
              "iris"
            ]
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "shot_no",
                "line_ids",
                "description",
                "component",
                "entrance"
              ],
              "properties": {
                "shot_no": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9]{2,3}$"
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "component": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                },
                "props": {
                  "type": "object"
                },
                "entrance": {
                  "enum": [
                    "push",
                    "rise",
                    "zoom"
                  ]
                },
                "asset_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "display_numbers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "text",
                      "source_claim_id"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_claim_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "illustrative": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
