{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets-manifest.schema.json",
  "title": "素材清单（顶层 {version, assets}）",
  "type": "object",
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "kind",
          "content",
          "source",
          "license",
          "needs_attribution",
          "opens",
          "usage",
          "usable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[0-9]{2,3}$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "needs_attribution": {
            "type": "boolean"
          },
          "attribution": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "opens": {
            "type": "boolean"
          },
          "usage": {
            "enum": [
              "fullscreen",
              "card-only",
              "rejected"
            ]
          },
          "usable": {
            "type": "boolean"
          },
          "source_name": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        }
      }
    }
  }
}