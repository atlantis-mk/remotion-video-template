{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "claim_id",
      "line_id",
      "value_display",
      "value_spoken",
      "url",
      "accessed"
    ],
    "properties": {
      "claim_id": {
        "type": "string",
        "minLength": 1
      },
      "line_id": {
        "type": "string",
        "pattern": "^[0-9]{2,3}$"
      },
      "value_display": {
        "type": "string",
        "minLength": 1
      },
      "value_spoken": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "publisher": {
        "type": "string"
      },
      "accessed": {
        "type": "string"
      }
    }
  }
}
