{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "script-lines.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "section",
      "text",
      "context",
      "speech_rate",
      "silence_ms"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[0-9]{2,3}$"
      },
      "section": {
        "type": "string",
        "pattern": "^S[0-9]{2}$"
      },
      "section_title": {
        "type": "string"
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "context": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "speech_rate": {
        "type": "integer",
        "minimum": -50,
        "maximum": 100
      },
      "silence_ms": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
